{
    "compilerOptions": {
        "jsx": "react-jsx",
        "checkJs": true,
        "removeComments": true,
        "preserveConstEnums": true,
        "verbatimModuleSyntax": false,
        "target": "ESNext",
        "module": "commonjs",
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noImplicitAny": true,
        "sourceMap": true,
        "baseUrl": ".",
        "outDir": "dist",
        "moduleResolution": "node",
        "resolveJsonModule": true
    }
}